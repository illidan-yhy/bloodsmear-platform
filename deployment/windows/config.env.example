# Default: this computer only. Change to 0.0.0.0 for LAN access.
BLOODSMEAR_HOST=127.0.0.1
BLOODSMEAR_PORT=8000
BLOODSMEAR_REQUIRE_GPU=true
BLOODSMEAR_MODEL_DIR=models/blood-cell-yolo11/1.0.0
BLOODSMEAR_OUTPUT_DIR=outputs
BLOODSMEAR_DATABASE_PATH=data/bloodsmear.db
BLOODSMEAR_JOBS_ROOT=data/jobs
BLOODSMEAR_LOG_DIR=logs
BLOODSMEAR_LOG_LEVEL=INFO
BLOODSMEAR_LOG_RETENTION_DAYS=14
BLOODSMEAR_LOG_TO_CONSOLE=true
